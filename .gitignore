# Rust / Cargo
/target/
**/*.rs.bk


# Nix
/result
.direnv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*
# Exception: the committed template (operator copies it to `.env`,
# which is then caught by the rule above).
!.env.example

# Agent skills / AI tooling. Shared repo config is tracked; anything personal
# or per-session is not.
.agents/
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json
.claude/worktrees/
skills-lock.json

# Engine runtime state (default state_dir from engine.toml).
data/
# Shipped crate data slices are source, not runtime state: keep them.
!crates/*/data/
!crates/*/data/**

# E2E automation: rendered configs with embedded RPC keys + script state
# never get committed.
*.local.toml
scripts/.state
scripts/.env

# Operator-supplied engine config (carries paid RPC URLs / API keys).
# Only the exact name is ignored: the committed `engine.dev.toml` that
# `just run` reads is a secret-free template and stays tracked.
/engine.toml

# Generated reports under e2e-reports/ (operator commits the filled-in ones
# manually via `git add -f`).
docs/operations/e2e-reports/engine-*.log
docs/operations/e2e-reports/metrics-*.txt
